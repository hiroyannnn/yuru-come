///|
/// scripts/embed_assets.py が web/ から生成する。手で編集しない。
/// `--web-dir` を指定しないとき、この中身を返す。
let embedded_assets : Map[String, String] = {
  "index.html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>yuru-come</title>\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n  <header class=\"topbar\">\n    <h1>yuru-come</h1>\n    <p class=\"context\" id=\"context\"></p>\n    <p class=\"promo-live\" id=\"promo-live\" hidden></p>\n    <button class=\"details-toggle\" id=\"details-toggle\" type=\"button\" aria-pressed=\"false\">詳細</button>\n    <p class=\"conn\" id=\"conn\" role=\"status\">接続中…</p>\n  </header>\n  <main class=\"panels\">\n    <section class=\"panel pickups\" aria-labelledby=\"pickups-title\">\n      <h2 id=\"pickups-title\">気になるコメント <span class=\"count\" id=\"pickup-count\"></span></h2>\n      <p class=\"hint\">読んだらクリックで消えます。× はスルー。放っておいても 10 分で消えます。</p>\n      <ol class=\"pickup-list\" id=\"pickups\"></ol>\n      <p class=\"empty\" id=\"pickups-empty\">いまは拾うものがありません。全部読まなくて大丈夫。</p>\n    </section>\n\n    <section class=\"panel mood\" aria-labelledby=\"mood-title\">\n      <h2 id=\"mood-title\">いまの空気</h2>\n      <p class=\"summary\" id=\"summary\"><span class=\"summary-text\" id=\"summary-text\"></span> <span class=\"summary-source\" id=\"summary-source\"></span></p>\n      <div class=\"bundles\" id=\"bundles\" aria-label=\"直近の反応の束\"></div>\n      <p class=\"empty\" id=\"bundles-empty\">まとまった反応はまだありません。</p>\n\n      <div class=\"meters\">\n        <div class=\"meter\"><span class=\"meter-value\" id=\"rate\">0.0</span><span class=\"meter-label\">件/秒（30 秒）</span></div>\n        <div class=\"meter\"><span class=\"meter-value\" id=\"participants\">0</span><span class=\"meter-label\">人（30 秒）</span></div>\n        <div class=\"meter\"><span class=\"meter-value\" id=\"rate-long\">0.0</span><span class=\"meter-label\">件/秒（5 分）</span></div>\n      </div>\n\n      <h3>種類の分布 <span class=\"sub\">直近 5 分</span></h3>\n      <div class=\"kindbar\" id=\"kindbar\" role=\"img\" aria-label=\"種類の分布\"></div>\n      <ul class=\"legend\" id=\"legend\"></ul>\n\n      <h3 class=\"details\">Jev</h3>\n      <div class=\"queue details\">\n        <div class=\"queue-track\"><div class=\"queue-fill\" id=\"queue-fill\"></div></div>\n        <p class=\"queue-text\" id=\"queue-text\"></p>\n      </div>\n      <p class=\"stats details\" id=\"stats\"></p>\n    </section>\n\n    <section class=\"panel flow\" aria-labelledby=\"flow-title\">\n      <h2 id=\"flow-title\">全部の流れ</h2>\n      <ol class=\"flow-list\" id=\"flow\"></ol>\n    </section>\n  </main>\n  <script src=\"/app.js\"></script>\n</body>\n</html>\n",
  "style.css": ":root {\n  --bg: #14161a;\n  --panel: #1c1f25;\n  --line: #2b3038;\n  --text: #e8eaed;\n  --muted: #8b929c;\n  --accent: #ffd166;\n  --danger: #ff5d5d;\n  --question: #5cc8ff;\n  --request: #b692ff;\n  --feedback: #7ddc8c;\n  --correction: #ffb454;\n  --greeting: #8fa3b8;\n  --first_time: #ff8fc7;\n  --trouble: #ff5d5d;\n  --abuse: #70757d;\n  --chatter: #6f7b8a;\n  --reaction: #4a525e;\n  --unjudged: #3a4049;\n}\n\n* { box-sizing: border-box; }\n\nhtml, body { height: 100%; }\n\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--text);\n  font-family: \"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic UI\", \"Meiryo\", system-ui, sans-serif;\n  font-size: 15px;\n  line-height: 1.5;\n  display: flex;\n  flex-direction: column;\n}\n\n.topbar {\n  display: flex;\n  align-items: baseline;\n  gap: 16px;\n  padding: 8px 16px;\n  border-bottom: 1px solid var(--line);\n  flex-wrap: wrap;\n}\n.topbar h1 { margin: 0; font-size: 16px; letter-spacing: .04em; color: var(--accent); }\n.context { margin: 0; color: var(--muted); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.conn { margin: 0; font-size: 12px; color: var(--muted); }\n.promo-live { margin: 0; font-size: 12px; color: var(--accent); }\n.details-toggle {\n  font: inherit; font-size: 12px; color: var(--muted); background: none;\n  border: 1px solid var(--line); border-radius: 999px; padding: 0 10px; cursor: pointer;\n}\n.details-toggle[aria-pressed=\"true\"] { color: var(--text); border-color: var(--muted); }\nbody:not(.show-details) .details { display: none !important; }\n.conn.down { color: var(--danger); }\n\n.panels {\n  flex: 1;\n  min-height: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr);\n  gap: 1px;\n  background: var(--line);\n}\n\n.panel {\n  background: var(--panel);\n  padding: 12px 16px 16px;\n  overflow-y: auto;\n  min-height: 0;\n}\n.panel h2 { margin: 0 0 4px; font-size: 14px; font-weight: 600; color: var(--muted); letter-spacing: .06em; }\n.panel h3 { margin: 20px 0 8px; font-size: 12px; font-weight: 600; color: var(--muted); letter-spacing: .06em; }\n.sub { font-weight: 400; }\n.count { color: var(--accent); }\n.hint, .empty { margin: 0 0 8px; font-size: 12px; color: var(--muted); }\n.empty { padding: 16px 0; }\n[hidden] { display: none !important; }\n\n/* 気になるコメント */\n.pickup-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }\n.pickup {\n  width: 100%;\n  text-align: left;\n  font: inherit;\n  color: inherit;\n  background: #232730;\n  border: 1px solid var(--line);\n  border-left: 4px solid var(--kind, var(--muted));\n  border-radius: 6px;\n  padding: 10px 12px;\n  cursor: pointer;\n  display: block;\n  transition: opacity .4s, background .15s;\n}\n.pickup:hover, .pickup:focus-visible { background: #2a2f3a; outline: none; border-color: var(--kind, var(--muted)); }\n.pickup.faded { opacity: .45; }\n.pickup.pinned { background: #33202a; border-color: var(--danger); }\n.pickup-head { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }\n.pickup-row { position: relative; }\n.skip {\n  position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; line-height: 22px; text-align: center;\n  font: inherit; font-size: 14px; color: var(--muted); background: none; border: 1px solid transparent; border-radius: 50%; cursor: pointer;\n}\n.skip:hover, .skip:focus-visible { color: var(--text); border-color: var(--line); outline: none; }\n.pickup-row .age { margin-right: 28px; }\n.pickup-text { margin-top: 4px; font-size: 18px; line-height: 1.45; overflow-wrap: anywhere; }\n.pickup.pinned .pickup-text { font-weight: 600; }\n.badge {\n  display: inline-block;\n  padding: 0 8px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n  color: #14161a;\n  background: var(--kind, var(--muted));\n  white-space: nowrap;\n}\n.priority { font-variant-numeric: tabular-nums; }\n.echo { color: var(--accent); font-weight: 600; }\n.author { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 16em; }\n.age { margin-left: auto; font-variant-numeric: tabular-nums; }\n\n/* いまの空気 */\n.summary { margin: 4px 0 12px; font-size: 17px; line-height: 1.5; }\n.summary-text { color: var(--text); }\n.summary.template .summary-text { color: var(--muted); }\n.summary-source { font-size: 11px; color: var(--muted); white-space: nowrap; }\n.bundles { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; margin-top: 8px; min-height: 48px; }\n.bundle { display: inline-flex; align-items: baseline; gap: 6px; max-width: 100%; }\n.bundle-text { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 12em; }\n.bundle-count { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 600; }\n.bundle-people { font-size: 11px; color: var(--muted); }\n\n.meters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 16px; }\n.meter { background: #232730; border-radius: 6px; padding: 8px 10px; }\n.meter-value { display: block; font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; }\n.meter-label { font-size: 11px; color: var(--muted); }\n\n.kindbar { display: flex; height: 18px; border-radius: 4px; overflow: hidden; background: #232730; }\n.kindbar span { display: block; height: 100%; background: var(--kind); min-width: 2px; }\n.legend { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; color: var(--muted); }\n.legend li::before { content: \"\"; display: inline-block; width: 8px; height: 8px; border-radius: 2px; background: var(--kind); margin-right: 4px; }\n.legend b { color: var(--text); font-variant-numeric: tabular-nums; }\n\n.queue-track { height: 8px; border-radius: 4px; background: #232730; overflow: hidden; }\n.queue-fill { height: 100%; width: 0; background: var(--feedback); transition: width .3s; }\n.queue-fill.busy { background: var(--correction); }\n.queue-fill.full { background: var(--danger); }\n.queue-text, .stats { margin: 6px 0 0; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }\n.stats b { color: var(--text); }\n.stats .dropped { color: var(--danger); }\n\n/* 全部の流れ */\n.flow-list { list-style: none; margin: 8px 0 0; padding: 0; font-size: 13px; }\n.flow-item { display: flex; gap: 8px; padding: 3px 0; border-bottom: 1px solid #22262d; align-items: baseline; }\n.flow-item .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--kind, var(--unjudged)); transform: translateY(-1px); }\n.flow-item .who { flex: none; max-width: 12em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); }\n.flow-item .body { min-width: 0; overflow-wrap: anywhere; }\n.flow-item.reaction { opacity: .45; }\n.flow-item.pending .dot { background: transparent; border: 1px solid var(--muted); }\n.flow-item.picked .body { color: var(--accent); }\n.flow-item.abuse .body { color: var(--muted); }\n.flow-item.abuse .body button {\n  font: inherit; color: var(--muted); background: none; border: 1px dashed var(--line); border-radius: 4px; padding: 0 6px; cursor: pointer;\n}\n.flow-item .tag { flex: none; margin-left: auto; font-size: 11px; color: var(--muted); white-space: nowrap; }\n\n@media (max-width: 900px) {\n  body { height: auto; }\n  .panels { grid-template-columns: minmax(0, 1fr); }\n  .panel { overflow-y: visible; }\n  .flow-list { max-height: 60vh; overflow-y: auto; }\n  .pickup-text { font-size: 16px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .pickup, .queue-fill { transition: none; }\n}\n",
  "app.js": "// yuru-come ダッシュボード。/api/state を 1 秒ごとに読んで描き直すだけの素の JS。\n// コメント本文は信用できない入力なので、必ず textContent で入れる（innerHTML に渡さない）。\n\"use strict\";\n\nconst KINDS = {\n  question: \"質問\", request: \"リクエスト\", feedback: \"感想\", correction: \"指摘\",\n  greeting: \"挨拶\", first_time: \"初見\", trouble: \"トラブル\", abuse: \"荒らし\",\n  chatter: \"雑談\", reaction: \"反応\", unjudged: \"未判定\",\n};\nconst KIND_ORDER = [\"trouble\", \"question\", \"correction\", \"request\", \"first_time\", \"feedback\", \"greeting\", \"chatter\", \"abuse\", \"reaction\", \"unjudged\"];\nconst STATUS_TAGS = { pending: \"判定待ち\", dropped: \"未判定（間引き）\", failed: \"未判定（失敗）\" };\nconst POLL_MS = 1000;\n\nconst $ = (id) => document.getElementById(id);\nconst openedAbuse = new Set();\nconst dismissed = new Set();\n\nfunction el(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) node.className = className;\n  if (text !== undefined) node.textContent = text;\n  return node;\n}\n\n// ID をキーに DOM を使い回す。毎秒作り直すと、押している最中のボタンが差し替わってクリックが落ちる。\nfunction syncList(container, items, create, update) {\n  const existing = new Map();\n  for (const node of container.children) existing.set(node.dataset.key, node);\n  const nodes = items.map((item) => {\n    const key = String(item.id);\n    let node = existing.get(key);\n    if (!node) {\n      node = create(item);\n      node.dataset.key = key;\n    }\n    update(node, item);\n    return node;\n  });\n  nodes.forEach((node, index) => {\n    if (container.children[index] !== node) container.insertBefore(node, container.children[index] || null);\n  });\n  while (container.children.length > nodes.length) container.lastElementChild.remove();\n}\n\nfunction kindColor(node, kind) {\n  node.style.setProperty(\"--kind\", `var(--${kind})`);\n}\n\nfunction ageText(now, at) {\n  const sec = Math.max(0, Math.round((now - at) / 1000));\n  return sec < 60 ? `${sec}秒前` : `${Math.floor(sec / 60)}分前`;\n}\n\nfunction authorText(comment) {\n  const platform = comment.participant_id.split(\":\")[0];\n  const name = comment.author || comment.participant_id.split(\":\").slice(1).join(\":\");\n  const place = comment.channel ? `${platform} #${comment.channel}` : platform;\n  return `${place} / ${name}`;\n}\n\nfunction createPickup(item) {\n  const li = el(\"li\", \"pickup-row\");\n  const skip = el(\"button\", \"skip\", \"×\");\n  skip.type = \"button\";\n  skip.title = \"スルー（拾わずに消す）\";\n  skip.setAttribute(\"aria-label\", \"スルー\");\n  skip.addEventListener(\"click\", (event) => { event.stopPropagation(); dismiss(item.id, \"skipped\"); });\n  const button = el(\"button\", \"pickup\");\n  button.type = \"button\";\n  const head = el(\"div\", \"pickup-head\");\n  head.append(\n    el(\"span\", \"badge\"), el(\"span\", \"priority\"), el(\"span\", \"echo\"),\n    el(\"span\", \"author\"), el(\"span\", \"age\"),\n  );\n  button.append(head, el(\"div\", \"pickup-text\"));\n  button.addEventListener(\"click\", () => dismiss(item.id, \"picked\"));\n  li.append(button, skip);\n  return li;\n}\n\nfunction updatePickup(state, li, item) {\n  const button = li.querySelector(\".pickup\");\n  kindColor(button, item.kind);\n  button.classList.toggle(\"faded\", item.faded);\n  button.classList.toggle(\"pinned\", item.pinned);\n  button.querySelector(\".badge\").textContent = KINDS[item.kind] || item.kind;\n  button.querySelector(\".priority\").textContent = `拾う度 ${item.priority.toFixed(1)}`;\n  const echo = button.querySelector(\".echo\");\n  echo.textContent = item.count > 1 ? `同じコメント ×${item.count}` : \"\";\n  echo.hidden = item.count <= 1;\n  button.querySelector(\".author\").textContent = authorText(item.comment);\n  button.querySelector(\".age\").textContent = ageText(state.now, item.at);\n  button.querySelector(\".pickup-text\").textContent = item.comment.text;\n}\n\nfunction renderPickups(state) {\n  const items = state.pickups.filter((item) => !dismissed.has(item.id));\n  $(\"pickup-count\").textContent = items.length ? String(items.length) : \"\";\n  $(\"pickups-empty\").hidden = items.length > 0;\n  syncList($(\"pickups\"), items, createPickup, (li, item) => updatePickup(state, li, item));\n}\n\n// action は \"picked\"（拾った）か \"skipped\"（スルー）。正解データとしてサーバ側に記録される\nasync function dismiss(id, action) {\n  dismissed.add(id);\n  if (lastState) renderPickups(lastState);\n  try {\n    await fetch(\"/api/dismiss\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ id, action }),\n    });\n  } catch (_) {\n    dismissed.delete(id);\n  }\n  refresh();\n}\n\nfunction renderBundles(state) {\n  const bundles = state.bundles;\n  $(\"bundles-empty\").hidden = bundles.length > 0;\n  const max = bundles.reduce((m, b) => Math.max(m, b.count), 1);\n  $(\"bundles\").replaceChildren(...bundles.map((bundle) => {\n    const node = el(\"span\", \"bundle\");\n    // 件数が多い束ほど大きく。18px〜44px\n    const size = 18 + Math.round(26 * Math.sqrt(bundle.count / max));\n    const text = el(\"span\", \"bundle-text\", bundle.representative);\n    text.style.fontSize = `${size}px`;\n    const count = el(\"span\", \"bundle-count\", `×${bundle.count}`);\n    count.style.fontSize = `${Math.max(14, Math.round(size * 0.6))}px`;\n    node.append(text, count, el(\"span\", \"bundle-people\", `${bundle.participants}人`));\n    return node;\n  }));\n}\n\nfunction renderPromos(state) {\n  const promos = state.promos || [];\n  const node = $(\"promo-live\");\n  node.hidden = promos.length === 0;\n  node.textContent = promos.length ? `オーバーレイに表示中: ${promos.map((p) => p.label).join(\"、\")}` : \"\";\n}\n\nfunction renderSummary(state) {\n  const summary = state.summary || { text: \"\", source: \"template\" };\n  $(\"summary-text\").textContent = summary.text;\n  $(\"summary\").classList.toggle(\"template\", summary.source !== \"llm\");\n  $(\"summary-source\").textContent = summary.source === \"llm\" ? `（LLM、${ageText(state.now, summary.at)}）` : \"\";\n  $(\"summary-source\").classList.add(\"details\");\n}\n\nfunction renderMood(state) {\n  $(\"rate\").textContent = state.mood_short.rate_per_sec.toFixed(1);\n  $(\"participants\").textContent = String(state.mood_short.participants);\n  $(\"rate-long\").textContent = state.mood_long.rate_per_sec.toFixed(1);\n  const byKind = state.mood_long.by_kind;\n  const total = state.mood_long.total || 1;\n  const kinds = KIND_ORDER.filter((kind) => byKind[kind] > 0);\n  $(\"kindbar\").replaceChildren(...kinds.map((kind) => {\n    const bar = el(\"span\");\n    kindColor(bar, kind);\n    bar.style.width = `${(100 * byKind[kind]) / total}%`;\n    bar.title = `${KINDS[kind]} ${byKind[kind]}`;\n    return bar;\n  }));\n  $(\"legend\").replaceChildren(...kinds.map((kind) => {\n    const li = el(\"li\");\n    kindColor(li, kind);\n    li.append(`${KINDS[kind]} `, el(\"b\", \"\", String(byKind[kind])));\n    return li;\n  }));\n}\n\nfunction renderStats(state) {\n  const s = state.stats;\n  const ratio = s.queue_limit > 0 ? s.queue_length / s.queue_limit : 0;\n  const fill = $(\"queue-fill\");\n  fill.style.width = `${Math.min(100, Math.round(ratio * 100))}%`;\n  fill.classList.toggle(\"busy\", ratio >= 0.5 && ratio < 0.9);\n  fill.classList.toggle(\"full\", ratio >= 0.9);\n  const delay = (s.judge_delay_ms / 1000).toFixed(1);\n  $(\"queue-text\").textContent = `判定待ち ${s.queue_length} / ${s.queue_limit}（判定中 ${s.in_flight}）／ 直近の判定の遅れ ${delay} 秒`;\n  const skipped = s.early + s.inherited;\n  const percent = s.received ? Math.round((100 * skipped) / s.received) : 0;\n  const stats = $(\"stats\");\n  stats.replaceChildren(\n    \"受信 \", el(\"b\", \"\", String(s.received)),\n    \" ／ Jev を省いた \", el(\"b\", \"\", `${skipped}（${percent}%）`),\n    \" ／ Jev に投げた \", el(\"b\", \"\", String(s.sent)),\n    \" ／ 失敗 \", el(\"b\", \"\", String(s.failed)),\n    \" ／ 間引き \", el(\"b\", s.dropped > 0 ? \"dropped\" : \"\", String(s.dropped)),\n  );\n}\n\nfunction createFlowItem() {\n  const li = el(\"li\", \"flow-item\");\n  li.append(el(\"span\", \"dot\"), el(\"span\", \"who\"), el(\"span\", \"body\"), el(\"span\", \"tag\"));\n  return li;\n}\n\nfunction updateFlowItem(li, entry) {\n  const folded = entry.kind === \"abuse\" && !openedAbuse.has(entry.id);\n  // 変化が無ければ触らない（判定待ち → 判定済み、折りたたみの開閉のときだけ描き直す）\n  const signature = `${entry.kind}|${entry.status}|${entry.pickup_id}|${folded}`;\n  if (li.dataset.signature === signature) return;\n  li.dataset.signature = signature;\n  li.className = \"flow-item\";\n  kindColor(li, entry.kind);\n  li.classList.toggle(\"reaction\", entry.kind === \"reaction\");\n  li.classList.toggle(\"pending\", entry.status === \"pending\");\n  li.classList.toggle(\"picked\", entry.pickup_id != null);\n  li.classList.toggle(\"abuse\", entry.kind === \"abuse\");\n  const who = entry.comment.author || entry.comment.participant_id;\n  li.querySelector(\".who\").textContent = entry.comment.channel ? `#${entry.comment.channel} ${who}` : who;\n  li.querySelector(\".who\").title = authorText(entry.comment);\n  const body = li.querySelector(\".body\");\n  if (folded) {\n    const button = el(\"button\", \"\", \"荒らしと判定（クリックで表示）\");\n    button.type = \"button\";\n    button.addEventListener(\"click\", () => {\n      openedAbuse.add(entry.id);\n      if (lastState) renderFlow(lastState);\n    });\n    body.replaceChildren(button);\n  } else {\n    body.textContent = entry.comment.text;\n  }\n  li.querySelector(\".tag\").textContent = STATUS_TAGS[entry.status] ||\n    (entry.kind !== \"reaction\" && entry.kind !== \"unjudged\" ? KINDS[entry.kind] : \"\");\n}\n\nfunction renderFlow(state) {\n  syncList($(\"flow\"), state.flow, createFlowItem, updateFlowItem);\n}\n\nlet lastState = null;\n\n// 画面から消えた ID を覚え続けないようにする\nfunction forgetGone(state) {\n  const pickupIds = new Set(state.pickups.map((item) => item.id));\n  for (const id of dismissed) if (!pickupIds.has(id)) dismissed.delete(id);\n  const flowIds = new Set(state.flow.map((entry) => entry.id));\n  for (const id of openedAbuse) if (!flowIds.has(id)) openedAbuse.delete(id);\n}\n\nfunction render(state) {\n  lastState = state;\n  forgetGone(state);\n  $(\"context\").textContent = state.context ? `文脈: ${state.context}` : \"\";\n  renderPickups(state);\n  renderPromos(state);\n  renderSummary(state);\n  renderBundles(state);\n  renderMood(state);\n  renderStats(state);\n  renderFlow(state);\n}\n\nlet refreshing = false;\n\nasync function refresh() {\n  // サーバの返事が遅いときに、ポーリングを積み上げない\n  if (refreshing) return;\n  refreshing = true;\n  try {\n    const response = await fetch(\"/api/state\", { cache: \"no-store\" });\n    if (!response.ok) throw new Error(String(response.status));\n    render(await response.json());\n    $(\"conn\").textContent = \"接続中\";\n    $(\"conn\").classList.remove(\"down\");\n  } catch (_) {\n    $(\"conn\").textContent = \"サーバに接続できません\";\n    $(\"conn\").classList.add(\"down\");\n  } finally {\n    refreshing = false;\n  }\n}\n\n// デバッグ寄りの情報（Jev の滞留、件数、要約の出所）は「詳細」で出す。設定はこのブラウザに記憶する\nfunction setDetails(on) {\n  document.body.classList.toggle(\"show-details\", on);\n  $(\"details-toggle\").setAttribute(\"aria-pressed\", String(on));\n  try { localStorage.setItem(\"yuru-come.details\", on ? \"1\" : \"0\"); } catch (_) {}\n}\nlet detailsOn = false;\ntry { detailsOn = localStorage.getItem(\"yuru-come.details\") === \"1\"; } catch (_) {}\nsetDetails(detailsOn);\n$(\"details-toggle\").addEventListener(\"click\", () => setDetails(!document.body.classList.contains(\"show-details\")));\n\nrefresh();\nsetInterval(refresh, POLL_MS);\n",
  "overlay.html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>yuru-come overlay</title>\n  <style>\n    /* OBS のブラウザソース用。背景は透過。話題になった商品の QR とリンクだけを出す */\n    html, body { margin: 0; background: transparent; }\n    body { font-family: \"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic UI\", system-ui, sans-serif; color: #fff; }\n    .promos { position: fixed; right: 24px; bottom: 24px; display: flex; flex-direction: column; gap: 12px; align-items: flex-end; }\n    .promo {\n      display: flex; align-items: center; gap: 14px;\n      background: rgba(20, 22, 26, .88); border: 2px solid #ffd166; border-radius: 12px; padding: 12px 16px 12px 12px;\n      box-shadow: 0 6px 24px rgba(0, 0, 0, .4);\n      animation: pop .3s ease-out;\n    }\n    .promo img { width: 120px; height: 120px; background: #fff; border-radius: 6px; }\n    .promo .label { font-size: 22px; font-weight: 700; margin: 0 0 4px; }\n    .promo .url { font-size: 15px; color: #ffd166; margin: 0; word-break: break-all; max-width: 32em; }\n    .promo .trigger { font-size: 13px; color: #b6bcc6; margin: 6px 0 0; max-width: 32em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n    @keyframes pop { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }\n  </style>\n</head>\n<body>\n  <div class=\"promos\" id=\"promos\"></div>\n  <script>\n    \"use strict\";\n    const container = document.getElementById(\"promos\");\n    function el(tag, className, text) {\n      const node = document.createElement(tag);\n      if (className) node.className = className;\n      if (text !== undefined) node.textContent = text;\n      return node;\n    }\n    function render(promos) {\n      const existing = new Map([...container.children].map((node) => [node.dataset.key, node]));\n      const nodes = promos.map((promo) => {\n        const key = `${promo.url}@${promo.shown_at}`;\n        let node = existing.get(key);\n        if (!node) {\n          node = el(\"div\", \"promo\");\n          node.dataset.key = key;\n          const img = el(\"img\");\n          img.alt = \"QR\";\n          img.src = `/api/qr.svg?text=${encodeURIComponent(promo.url)}`;\n          const text = el(\"div\");\n          text.append(el(\"p\", \"label\", promo.label), el(\"p\", \"url\", promo.url), el(\"p\", \"trigger\", `「${promo.trigger}」`));\n          node.append(img, text);\n        }\n        return node;\n      });\n      container.replaceChildren(...nodes);\n    }\n    let refreshing = false;\n    async function refresh() {\n      if (refreshing) return;\n      refreshing = true;\n      try {\n        const response = await fetch(\"/api/state\", { cache: \"no-store\" });\n        if (response.ok) render((await response.json()).promos || []);\n      } catch (_) {\n      } finally {\n        refreshing = false;\n      }\n    }\n    refresh();\n    setInterval(refresh, 1000);\n  </script>\n</body>\n</html>\n",
}
