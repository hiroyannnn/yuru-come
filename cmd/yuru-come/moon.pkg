import {
  "hiroyannnn/yuru-come/lib",
  "hiroyannnn/yuru-come/runtime",
  "hiroyannnn/yuru-come/jev",
  "hiroyannnn/yuru-come/adapters/stdin" @stdin_source,
  "hiroyannnn/yuru-come/adapters/replay" @replay_source,
  "hiroyannnn/yuru-come/adapters/terminal" @terminal_sink,
  "hiroyannnn/yuru-come/adapters/twitch" @twitch_source,
  "hiroyannnn/yuru-come/adapters/youtube" @youtube_source,
  "hiroyannnn/yuru-come/adapters/web" @web_adapter,
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/async",
}

supported_targets = "-all+native"

pkgtype(kind: "executable")
